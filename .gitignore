# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.eggs/
*.egg-info/
*.egg
build/
dist/

# Env / secrets
.env
.env.local
*.key

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# Streamlit
.streamlit/secrets.toml

# Runtime cache (we keep the dir but ignore its contents)
data/cache/*
!data/cache/.gitkeep
# Endcards are intentionally tracked: they're hand-curated brand assets
# (one PNG + one MP4 per Voodoo game) generated via scripts.generate_endcards
# + scripts.animate_endcards. Every deploy needs them on disk to append at
# the end of /api/variants/render-video outputs.
!data/cache/endcards/
!data/cache/endcards/**
# PM-uploaded screenshots/mockups for the prototype mode
data/uploads/
# Notebook stray cache (shouldn't happen anymore — modules now resolve to repo root)
notebooks/data/

# Parallel sub-agent experiments (kept on disk, untracked)
voodradar-codex/

# Notebooks
# We work in .py jupytext format. Convert on demand with:
#   uv run jupytext --to ipynb notebooks/<file>.py
# .ipynb files are never committed — their outputs can leak secrets (e.g. API
# tokens captured in httpx INFO logs are inlined into cell outputs).
.ipynb_checkpoints/
*.ipynb_meta
*.ipynb
**/Untitled*.py

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# uv
uv.lock

# Frontend deps
front/node_modules/
front/dist/
front/.tanstack/

# Voodoo brand assets (reference only, not used at runtime)
voodooio_logo.*
*.brief.json
/genius-*.json
